{
  "expo": {
    "name": "projet-x",
    "slug": "projet-x",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.projetx.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAF9"
      },
      "package": "com.projetx.app",
      "userInterfaceStyle": "light",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "projet-x-links.vercel.app",
              "pathPrefix": "/reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF9",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#641E0A"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Projet-X utilise votre position pour trouver des artisans près de vous."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Projet-X accède à vos photos pour illustrer votre profil et vos réalisations."
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "projetx",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "86b2500c-1067-40ad-85a7-7096b1eb40fc"
      }
    },
    "owner": "chermann_king"
  }
}
